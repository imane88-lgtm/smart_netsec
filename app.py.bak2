@app.route("/ai/chat", methods=["POST"])
@login_required
def ai_chat():
    try:
        data    = request.get_json(force=True)
        message = (data.get("message") or "").strip()
        if not message:
            return jsonify({"reponse": "Message vide."}), 400
        reponse = ai.repondre(message)
        return jsonify({"reponse": reponse})
    except Exception as e:
        return jsonify({"reponse": f"Erreur : {str(e)}"}), 500


@app.route("/ai/resume")
@login_required
def ai_resume():
    try:
        return jsonify(ai.get_resume_systeme())
    except Exception as e:
        return jsonify({"error": str(e)}), 500


@app.route("/api/blocages")
@login_required
def api_blocages():
    try:
        conn = sqlite3.connect("smart_netsec.db")
        conn.row_factory = sqlite3.Row
        cursor = conn.cursor()
        cursor.execute(
            "SELECT * FROM blocages ORDER BY date_blocage DESC"
        )
        blocages = [dict(row) for row in cursor.fetchall()]
        conn.close()
        return jsonify(blocages)
    except:
        return jsonify([])


