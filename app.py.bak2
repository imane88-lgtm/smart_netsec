# Décorateurs
# ──────────────────────────────────────────────
def login_required(f):
    @wraps(f)
    def decorated(*args, **kwargs):
        if "user" not in session:
            return redirect(url_for("login"))
        return f(*args, **kwargs)
    return decorated

def admin_required(f):
    @wraps(f)
    def decorated(*args, **kwargs):
        if "user" not in session:
            return redirect(url_for("login"))
        if session["user"]["role"] != "admin":
            return render_template(
                "login.html",
                error="⛔ Accès réservé aux administrateurs"
            )
        return f(*args, **kwargs)
    return decorated


# ──────────────────────────────────────────────
# Login / Logout
# ──────────────────────────────────────────────
@app.route("/login", methods=["GET", "POST"])
def login():
    if "user" in session:
        return redirect(url_for("dashboard"))

    if request.method == "POST":
        username = request.form.get("username", "").strip()
        password = request.form.get("password", "")

        if not username or not password:
            return render_template(
                "login.html",
                error="⚠️ Veuillez remplir tous les champs"
            )

        user, message = verifier_login(username, password)

        if user:
            session.permanent = True
            session["user"] = {
                "id":       user["id"],
                "username": user["username"],
                "role":     user["role"],
            }
            return redirect(url_for("dashboard"))
        else:
            return render_template("login.html", error=message)

    return render_template("login.html")


@app.route("/logout")
def logout():
    session.clear()
    return redirect(url_for("login"))


# ──────────────────────────────────────────────
# Dashboard
# ──────────────────────────────────────────────
@app.route("/")
@login_required
def dashboard():
    appareils = get_appareils()
    alertes   = get_alertes()
    scans     = get_historique_scans()

    for a in appareils:
        if isinstance(a.get("ports_ouverts"), str):
            a["ports_ouverts"] = json.loads(a["ports_ouverts"])
        if isinstance(a.get("ports_risques"), str):
            a["ports_risques"] = json.loads(a["ports_risques"])

    scores      = [a["score"] for a in appareils if a.get("score")]
    score_moyen = round(sum(scores) / len(scores)) if scores else 0

    stats = {
        "nb_appareils":    len(appareils),
        "score_moyen":     score_moyen,
        "nb_safe":         sum(1 for a in appareils if a.get("score", 0) >= 80),
        "nb_medium":       sum(1 for a in appareils if 50 <= a.get("score", 0) < 80),
        "nb_danger":       sum(1 for a in appareils if a.get("score", 0) < 50),
        "nb_alertes":      len(alertes),
        "nb_alertes_high": sum(1 for al in alertes
                               if al.get("niveau") in ["HIGH", "CRITICAL"]),
        "nb_scans":        len(scans),
    }

    # Blocages
    try:
        conn = sqlite3.connect("smart_netsec.db")
        conn.row_factory = sqlite3.Row
        cursor = conn.cursor()
        cursor.execute("SELECT * FROM blocages WHERE actif=1")
        blocages = [dict(r) for r in cursor.fetchall()]
        conn.close()
    except:
        blocages = []

    # ── Suricata ──
    suricata_alertes = get_suricata_alertes(limit=10)
    suricata_stats   = get_suricata_stats()

    return render_template(
        "index.html",
        appareils=appareils,
        alertes=alertes[:10],
        stats=stats,
        scans=scans[:5],
        blocages=blocages,
        user=session["user"],
        suricata_alertes=suricata_alertes,
        suricata_stats=suricata_stats,
    )

# ──────────────────────────────────────────────
# Settings
# ──────────────────────────────────────────────
@app.route("/settings")
@admin_required
def settings():
    users = lister_utilisateurs()
    return render_template(
        "settings.html",
        user=session["user"],
        users=users,
        msg_success=request.args.get("success"),
        msg_error=request.args.get("error"),
    )

@app.route("/settings/changer-mdp", methods=["POST"])
@admin_required
def changer_mdp():
    ancien  = request.form.get("ancien_pwd", "")
    nouveau = request.form.get("nouveau_pwd", "")
    confirm = request.form.get("confirm_pwd", "")

    if nouveau != confirm:
        return redirect(url_for("settings") +
                        "?error=Les mots de passe ne correspondent pas")

    succes, msg = changer_mot_de_passe(
        session["user"]["username"], ancien, nouveau
    )
    if succes:
        return redirect(url_for("settings") + "?success=" + msg)
    return redirect(url_for("settings") + "?error=" + msg)


@app.route("/settings/creer-user", methods=["POST"])
@admin_required
def creer_user():
    username = request.form.get("username", "").strip()
    password = request.form.get("password", "")
    role     = request.form.get("role", "user")

    succes, msg = creer_utilisateur(username, password, role)
    if succes:
        return redirect(url_for("settings") + "?success=" + msg)
    return redirect(url_for("settings") + "?error=" + msg)


@app.route("/settings/deverrouiller/<username>")
@admin_required
def deverrouiller(username):
    succes, msg = deverrouiller_compte(username)
    return redirect(url_for("settings") + "?success=" + msg)


# ──────────────────────────────────────────────
# Scan
# ──────────────────────────────────────────────
scan_en_cours = {"actif": False}

@app.route("/lancer-scan")
@admin_required
def lancer_scan():
    global scan_en_cours
    if scan_en_cours["actif"]:
        return jsonify({"status": "busy"})

    def run_scan():
        scan_en_cours["actif"] = True
        try:
            subprocess.run(
                ["sudo", "python3", "scan_complet.py"],
                cwd="/home/imane/smart_netsec"
            )
        finally:
            scan_en_cours["actif"] = False

    threading.Thread(target=run_scan, daemon=True).start()
    return jsonify({"status": "started"})


@app.route("/api/scan-status")
@login_required
def scan_status():
    return jsonify(scan_en_cours)


