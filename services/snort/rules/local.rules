# local.rules — Règles Snort personnalisées Smart NetSec

# Scan Nmap SYN
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"ET SCAN Nmap SYN Scan"; flags:S; threshold:type threshold, track by_src, count 20, seconds 5; sid:9000001; rev:1;)

# Brute Force SSH
alert tcp $EXTERNAL_NET any -> $HOME_NET 22 (msg:"ET BRUTE SSH Brute Force Attempt"; flags:S; threshold:type threshold, track by_src, count 5, seconds 30; sid:9000002; rev:1;)

# Port SMB suspect
alert tcp $EXTERNAL_NET any -> $HOME_NET 445 (msg:"ET EXPLOIT SMB Port Access Suspicious"; flags:S; sid:9000003; rev:1;)

# Telnet non chiffré
alert tcp $EXTERNAL_NET any -> $HOME_NET 23 (msg:"POLICY Telnet Connection Attempt"; flags:S; sid:9000004; rev:1;)

# FTP non chiffré
alert tcp $EXTERNAL_NET any -> $HOME_NET 21 (msg:"POLICY FTP Connection Attempt"; flags:S; sid:9000005; rev:1;)

# ICMP flood
alert icmp $EXTERNAL_NET any -> $HOME_NET any (msg:"ET SCAN ICMP Sweep"; threshold:type threshold, track by_src, count 50, seconds 5; sid:9000006; rev:1;)

# HTTP suspect
alert tcp $EXTERNAL_NET any -> $HOME_NET 80 (msg:"ET WEB Suspicious HTTP Request"; content:"cmd.exe"; nocase; sid:9000007; rev:1;)

# SQL Injection basique
alert tcp $EXTERNAL_NET any -> $HOME_NET 80 (msg:"ET WEB SQL Injection Attempt"; content:"UNION SELECT"; nocase; sid:9000008; rev:1;)
